# Copy this file to .env.local and fill in real values. Never commit
# .env.local — it's already in .gitignore.

# --- Analytics (add later) ---
# NEXT_PUBLIC_GA4_ID=
# NEXT_PUBLIC_META_PIXEL_ID=

# --- Payments: Razorpay (required for checkout to work) ---
# Get these from the Razorpay Dashboard → Settings → API Keys.
# Use rzp_test_... keys while testing, rzp_live_... only once you're ready
# to accept real payments. NEITHER of these should ever carry a
# NEXT_PUBLIC_ prefix — both are read only on the server (see
# src/lib/razorpay.ts). The public key_id reaches the browser via the
# /api/razorpay/create-order response instead, never via a build-time env
# var.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Separate from the above — this is the "Secret" you set when you create
# the webhook endpoint in Razorpay Dashboard → Settings → Webhooks, NOT
# your API Key Secret. Only needed once you configure webhooks.
RAZORPAY_WEBHOOK_SECRET=

# --- Instagram (add later) ---
# INSTAGRAM_ACCESS_TOKEN=

# --- Email / newsletter provider (add later) ---
# EMAIL_PROVIDER_API_KEY=

# --- Instagram (add later) ---
# INSTAGRAM_ACCESS_TOKEN=

# --- Email / newsletter provider (add later) ---
# EMAIL_PROVIDER_API_KEY=
