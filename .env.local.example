# Copy to .env.local for local development. NEVER commit .env / .env.local.
# In Vercel, set these under Project → Settings → Environment Variables,
# scoped per environment (Preview first; Production only at launch).
# None of these are prefixed NEXT_PUBLIC_ — every value stays on the server.

# --- Database (Neon Postgres, pooled connection string) ---
DATABASE_URL=

# --- Razorpay (start with TEST keys: rzp_test_...) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you choose when creating the webhook in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=
# Live keys (rzp_live_...) are refused unless this is exactly "true".
# Set it ONLY in Production, ONLY after the owner approves going live.
PAYMENTS_LIVE_APPROVED=

# --- Resend (transactional email) ---
RESEND_API_KEY=
# Must use a domain verified in Resend, e.g. ARIVO OBJECTS <orders@arivoobjects.com>
EMAIL_FROM=
# Inbox that receives order and contact notifications
OWNER_EMAIL=

# --- Shiprocket (dedicated API user, NOT your main login) ---
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
# Must match the pickup location name in Shiprocket exactly (case and spaces)
SHIPROCKET_PICKUP_LOCATION=
# 6-digit PIN code of that pickup location (used for serviceability checks)
SHIPROCKET_PICKUP_PINCODE=
# "true" = also assign a courier (per your Shiprocket courier priority) and
# request pickup right after payment. Charges your Shiprocket wallet. Never
# runs on preview/test deployments.
SHIPROCKET_AUTO_SHIP=

# --- Operations ---
# Random string ≥ 16 chars; Vercel Cron sends it to /api/cron/process-orders
CRON_SECRET=
# Password for /admin (username "admin"); ≥ 12 chars, admin disabled if unset
ADMIN_PASSWORD=
# Random string used to hash IPs for rate limiting
IP_HASH_SALT=
# Canonical site URL used in email links (e.g. https://www.arivoobjects.com)
SITE_URL=
